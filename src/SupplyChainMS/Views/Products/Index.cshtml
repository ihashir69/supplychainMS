@*
   Views/Products/Index.cshtml
   - For Suppliers: shows their own product list with edit/delete buttons
   - For StoreManagers: shows a supplier's catalog (read-only)

   ViewBag.Supplier = the Supplier object (passed from controller)
   ViewBag.IsOwner  = true if the logged-in user is the supplier who owns these products
*@

@model List<SupplyChainMS.Models.Product>

@{
    ViewData["Title"] = "Products";
    var supplier = ViewBag.Supplier as SupplyChainMS.Models.Supplier;
    bool isOwner = ViewBag.IsOwner == true;
}

@* ---- BREADCRUMB ---- *@
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
        @if (!isOwner && supplier != null)
        {
            <li class="breadcrumb-item">
                <a asp-controller="Suppliers" asp-action="Index">Suppliers</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-controller="Suppliers" asp-action="Details" asp-route-id="@supplier.Id">
                    @supplier.CompanyName
                </a>
            </li>
        }
        <li class="breadcrumb-item active">Products</li>
    </ol>
</nav>

@* ---- HEADER ---- *@
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">
            <i class="bi bi-box-seam me-2 text-primary"></i>
            @(isOwner ? "My Products" : $"{supplier?.CompanyName} — Products")
        </h2>
        <p class="text-muted mb-0">@Model.Count product(s) listed</p>
    </div>
    @if (isOwner)
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add New Product
        </a>
    }
</div>

@* ---- EMPTY STATE ---- *@
@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-box display-1 text-muted"></i>
        <h4 class="mt-3 text-muted">No products yet</h4>
        @if (isOwner)
        {
            <p class="text-muted">Start adding products so stores can place orders.</p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Add First Product
            </a>
        }
        else
        {
            <p class="text-muted">This supplier has no products listed.</p>
        }
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th>Category</th>
                            <th>Unit Price</th>
                            <th>Unit</th>
                            <th>Stock</th>
                            @if (isOwner)
                            {
                                <th class="text-center">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-id="@product.Id"
                                       class="text-decoration-none fw-semibold">
                                        @product.Name
                                    </a>
                                    @if (!string.IsNullOrEmpty(product.Description))
                                    {
                                        <br />
                                        <small class="text-muted">
                                            @(product.Description.Length > 80
                                                ? product.Description[..80] + "..."
                                                : product.Description)
                                        </small>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(product.Category))
                                    {
                                        <span class="badge bg-secondary">@product.Category</span>
                                    }
                                    else { <span class="text-muted">—</span> }
                                </td>
                                <td class="fw-bold">PKR @product.UnitPrice.ToString("N0")</td>
                                <td>@product.Unit</td>
                                <td>
                                    @if (product.StockQuantity == 0)
                                    {
                                        <span class="badge bg-danger">Out of Stock</span>
                                    }
                                    else if (product.StockQuantity < 20)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            @product.StockQuantity (Low)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-success fw-semibold">@product.StockQuantity</span>
                                    }
                                </td>
                                @if (isOwner)
                                {
                                    <td class="text-center">
                                        <a asp-action="Edit" asp-route-id="@product.Id"
                                           class="btn btn-outline-secondary btn-sm me-1">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@product.Id"
                                           class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
