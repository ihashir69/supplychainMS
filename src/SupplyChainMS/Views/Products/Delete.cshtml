@*
   Views/Products/Delete.cshtml
   Confirmation page before permanently deleting a product.
   This is a safety step — without it, a misclick would delete the product.

   Pattern: GET /Products/Delete/5 → shows this page
             POST /Products/Delete/5 → actually deletes (handled by DeleteConfirmed action)
*@

@model SupplyChainMS.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-danger border-2">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>Confirm Delete
                </h4>
            </div>
            <div class="card-body p-4">
                <p class="lead">Are you sure you want to delete this product?</p>

                @* Show the product details so the user knows what they're deleting *@
                <div class="bg-light rounded p-3 mb-4">
                    <p class="mb-1"><strong>Name:</strong> @Model.Name</p>
                    <p class="mb-1"><strong>Category:</strong> @(Model.Category ?? "—")</p>
                    <p class="mb-1"><strong>Price:</strong> PKR @Model.UnitPrice.ToString("N2")</p>
                    <p class="mb-0"><strong>Stock:</strong> @Model.StockQuantity @Model.Unit</p>
                </div>

                <div class="alert alert-warning">
                    <i class="bi bi-info-circle me-1"></i>
                    <strong>Note:</strong> This cannot be undone. If this product is linked to
                    existing orders, the deletion will be blocked automatically.
                </div>

                @*
                   The actual delete is a POST form (not a link).
                   Using a GET link for deletes would be dangerous because
                   web crawlers and prefetch tools follow GET links automatically.
                   A form with POST requires intentional user action.
                *@
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>Yes, Delete It
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg me-1"></i>No, Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
