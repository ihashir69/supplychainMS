@*
   Views/Products/Details.cshtml
   Read-only view of a single product.
   Accessible to both Supplier and StoreManager roles.
*@

@model SupplyChainMS.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

@* ---- BREADCRUMB ---- *@
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
        @if (User.IsInRole("Supplier"))
        {
            <li class="breadcrumb-item"><a asp-action="Index">My Products</a></li>
        }
        else
        {
            <li class="breadcrumb-item"><a asp-controller="Suppliers" asp-action="Index">Suppliers</a></li>
            <li class="breadcrumb-item">
                <a asp-controller="Suppliers" asp-action="Details" asp-route-id="@Model.SupplierId">
                    @Model.Supplier?.CompanyName
                </a>
            </li>
        }
        <li class="breadcrumb-item active">@Model.Name</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h4 class="mb-0">
                    <i class="bi bi-box-seam me-2 text-primary"></i>@Model.Name
                </h4>
                @if (User.IsInRole("Supplier"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-pencil me-1"></i>Edit
                    </a>
                }
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <p class="text-muted small fw-bold mb-1">SUPPLIER</p>
                        <p class="mb-0">@Model.Supplier?.CompanyName</p>
                    </div>
                    <div class="col-md-6">
                        <p class="text-muted small fw-bold mb-1">CATEGORY</p>
                        <p class="mb-0">
                            @if (!string.IsNullOrEmpty(Model.Category))
                            {
                                <span class="badge bg-secondary fs-6">@Model.Category</span>
                            }
                            else { <span class="text-muted">Not specified</span> }
                        </p>
                    </div>
                    <div class="col-md-6">
                        <p class="text-muted small fw-bold mb-1">UNIT PRICE</p>
                        <p class="mb-0 fs-4 fw-bold text-primary">PKR @Model.UnitPrice.ToString("N2")</p>
                        <small class="text-muted">per @Model.Unit</small>
                    </div>
                    <div class="col-md-6">
                        <p class="text-muted small fw-bold mb-1">STOCK AVAILABLE</p>
                        @if (Model.StockQuantity == 0)
                        {
                            <span class="badge bg-danger fs-6">Out of Stock</span>
                        }
                        else if (Model.StockQuantity < 20)
                        {
                            <p class="mb-0">
                                <span class="badge bg-warning text-dark fs-6">@Model.StockQuantity @Model.Unit</span>
                                <br /><small class="text-warning">Low stock</small>
                            </p>
                        }
                        else
                        {
                            <p class="mb-0 fs-5 fw-semibold text-success">
                                @Model.StockQuantity @Model.Unit
                            </p>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="col-12">
                            <p class="text-muted small fw-bold mb-1">DESCRIPTION</p>
                            <p class="mb-0">@Model.Description</p>
                        </div>
                    }
                    <div class="col-md-6">
                        <p class="text-muted small fw-bold mb-1">ADDED ON</p>
                        <p class="mb-0">@Model.CreatedAt.ToString("dd MMM yyyy")</p>
                    </div>
                </div>

                <hr class="my-4" />

                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back to Products
                </a>
            </div>
        </div>
    </div>
</div>
