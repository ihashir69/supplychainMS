@*
   Views/Products/Create.cshtml
   Form to add a new product. Only accessible to Supplier role.
*@

@model SupplyChainMS.ViewModels.ProductCreateEditViewModel

@{
    ViewData["Title"] = "Add Product";
}

@* ---- BREADCRUMB ---- *@
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">My Products</a></li>
        <li class="breadcrumb-item active">Add Product</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0">
                    <i class="bi bi-plus-circle me-2 text-primary"></i>Add New Product
                </h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="SupplierId" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. USB-C Cable 2m" autofocus />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"
                                  placeholder="Describe the product, specs, materials, etc. (optional)"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="UnitPrice" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                @* input-group prepends "PKR" label before the input box *@
                                <span class="input-group-text">PKR</span>
                                <input asp-for="UnitPrice" class="form-control" type="number"
                                       min="0.01" step="0.01" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Unit" class="form-label fw-semibold"></label>
                            @*
                               <select> dropdown using asp-for + asp-items.
                               We hardcode common units here. The selected option is
                               auto-matched to the model's Unit value on Edit.
                            *@
                            <select asp-for="Unit" class="form-select">
                                <option value="piece">Piece</option>
                                <option value="kg">Kilogram (kg)</option>
                                <option value="gram">Gram</option>
                                <option value="litre">Litre</option>
                                <option value="box">Box</option>
                                <option value="carton">Carton</option>
                                <option value="dozen">Dozen</option>
                                <option value="metre">Metre</option>
                                <option value="set">Set</option>
                            </select>
                            <span asp-validation-for="Unit" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label fw-semibold"></label>
                            <input asp-for="Category" class="form-control"
                                   placeholder="e.g. Electronics, Food, Clothing" />
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="StockQuantity" class="form-label fw-semibold"></label>
                            <input asp-for="StockQuantity" class="form-control" type="number" min="0" />
                            <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-1"></i>Add Product
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
