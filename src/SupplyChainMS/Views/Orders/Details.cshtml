@*
   Views/Orders/Details.cshtml
   Shows the full order: header, status timeline, items table, and action buttons.
   Both StoreManager and Supplier see this page (with different buttons).
*@

@model SupplyChainMS.Models.Order

@{
    ViewData["Title"] = $"Order #{Model.Id}";
    bool isManager = User.IsInRole("StoreManager");
    bool isSupplier = User.IsInRole("Supplier");

    // What actions are available depends on role + current status
    bool canAddItems  = isManager  && Model.Status == SupplyChainMS.Models.OrderStatus.Draft;
    bool canSubmit    = isManager  && Model.Status == SupplyChainMS.Models.OrderStatus.Draft && Model.Items.Any();
    bool canConfirm   = isSupplier && Model.Status == SupplyChainMS.Models.OrderStatus.Submitted;
    bool canCancel    = (isManager  && (Model.Status == SupplyChainMS.Models.OrderStatus.Draft ||
                                        Model.Status == SupplyChainMS.Models.OrderStatus.Submitted))
                     || (isSupplier && Model.Status == SupplyChainMS.Models.OrderStatus.Submitted);
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Orders</a></li>
        <li class="breadcrumb-item active">Order #@Model.Id</li>
    </ol>
</nav>

@* ---- ORDER HEADER ---- *@
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <h3 class="mb-1">Order #@Model.Id</h3>
                <div class="d-flex gap-3 text-muted small flex-wrap">
                    <span><i class="bi bi-shop me-1"></i><strong>Branch:</strong> @Model.Store.Name</span>
                    <span><i class="bi bi-building me-1"></i><strong>Supplier:</strong> @Model.Supplier.CompanyName</span>
                    <span><i class="bi bi-calendar3 me-1"></i>@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <p class="mt-2 mb-0 text-muted"><i class="bi bi-chat-left-text me-1"></i>@Model.Notes</p>
                }
            </div>

            @* Status badge *@
            <div class="text-end">
                @switch (Model.Status)
                {
                    case SupplyChainMS.Models.OrderStatus.Draft:
                        <span class="badge bg-secondary fs-6 px-3 py-2">Draft</span>
                        break;
                    case SupplyChainMS.Models.OrderStatus.Submitted:
                        <span class="badge bg-warning text-dark fs-6 px-3 py-2">Submitted — Awaiting Confirmation</span>
                        break;
                    case SupplyChainMS.Models.OrderStatus.Confirmed:
                        <span class="badge bg-primary fs-6 px-3 py-2">Confirmed</span>
                        break;
                    case SupplyChainMS.Models.OrderStatus.Fulfilled:
                        <span class="badge bg-success fs-6 px-3 py-2">Fulfilled ✓</span>
                        break;
                    case SupplyChainMS.Models.OrderStatus.Cancelled:
                        <span class="badge bg-danger fs-6 px-3 py-2">Cancelled</span>
                        break;
                }
            </div>
        </div>

        @* ---- STATUS TIMELINE ---- *@
        <div class="mt-4 pt-3 border-top">
            <div class="d-flex gap-4 flex-wrap small">
                <div class="@(Model.CreatedAt != default ? "text-success" : "text-muted")">
                    <i class="bi bi-circle-fill me-1"></i>
                    <strong>Created</strong><br />
                    <span class="text-muted">@Model.CreatedAt.ToString("dd MMM, HH:mm")</span>
                </div>
                <div class="text-muted">→</div>
                <div class="@(Model.SubmittedAt.HasValue ? "text-success" : "text-muted")">
                    <i class="bi bi-circle-fill me-1"></i>
                    <strong>Submitted</strong><br />
                    <span>@(Model.SubmittedAt.HasValue ? Model.SubmittedAt.Value.ToString("dd MMM, HH:mm") : "—")</span>
                </div>
                <div class="text-muted">→</div>
                <div class="@(Model.ConfirmedAt.HasValue ? "text-success" : "text-muted")">
                    <i class="bi bi-circle-fill me-1"></i>
                    <strong>Confirmed</strong><br />
                    <span>@(Model.ConfirmedAt.HasValue ? Model.ConfirmedAt.Value.ToString("dd MMM, HH:mm") : "—")</span>
                </div>
                <div class="text-muted">→</div>
                <div class="@(Model.FulfilledAt.HasValue ? "text-success" : "text-muted")">
                    <i class="bi bi-circle-fill me-1"></i>
                    <strong>Fulfilled</strong><br />
                    <span>@(Model.FulfilledAt.HasValue ? Model.FulfilledAt.Value.ToString("dd MMM, HH:mm") : "—")</span>
                </div>
            </div>
        </div>
    </div>
</div>

@* ---- ORDER ITEMS TABLE ---- *@
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>Order Items</h5>
        @if (canAddItems)
        {
            <a asp-action="AddItem" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>Add Product
            </a>
        }
    </div>

    <div class="card-body p-0">
        @if (!Model.Items.Any())
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-cart display-4"></i>
                <p class="mt-2 mb-0">No products added yet.</p>
                @if (canAddItems)
                {
                    <a asp-action="AddItem" asp-route-id="@Model.Id" class="btn btn-primary mt-2">
                        <i class="bi bi-plus-lg me-1"></i>Add First Product
                    </a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th class="text-center">Quantity</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Line Total</th>
                            @if (canAddItems) { <th></th> }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.Product.Name</td>
                                <td class="text-center">@item.Quantity × @item.Product.Unit</td>
                                <td class="text-end">PKR @item.UnitPrice.ToString("N0")</td>
                                <td class="text-end fw-semibold">PKR @item.LineTotal.ToString("N0")</td>
                                @if (canAddItems)
                                {
                                    <td>
                                        <form asp-action="RemoveItem" asp-route-id="@item.Id"
                                              method="post" class="d-inline"
                                              onsubmit="return confirm('Remove @item.Product.Name?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="@(canAddItems ? 4 : 3)" class="text-end fw-bold">TOTAL</td>
                            <td class="text-end fw-bold fs-5">PKR @Model.TotalAmount.ToString("N0")</td>
                            @if (canAddItems) { <td></td> }
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>

@* ---- ACTION BUTTONS ---- *@
<div class="d-flex gap-2 flex-wrap">
    @if (canSubmit)
    {
        <form asp-action="Submit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success btn-lg"
                    onclick="return confirm('Submit this order to @Model.Supplier.CompanyName?')">
                <i class="bi bi-send me-1"></i>Submit Order to Supplier
            </button>
        </form>
    }

    @if (canConfirm)
    {
        <form asp-action="Confirm" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary btn-lg"
                    onclick="return confirm('Confirm this order from @Model.Store.Name?')">
                <i class="bi bi-check-circle me-1"></i>Confirm Order
            </button>
        </form>
    }

    @if (canCancel)
    {
        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger"
                    onclick="return confirm('Cancel this order? This cannot be undone.')">
                <i class="bi bi-x-circle me-1"></i>Cancel Order
            </button>
        </form>
    }

    @if (Model.Status == SupplyChainMS.Models.OrderStatus.Confirmed && Model.Shipment == null && isSupplier)
    {
        <a asp-controller="Shipments" asp-action="Create" asp-route-orderId="@Model.Id"
           class="btn btn-warning btn-lg">
            <i class="bi bi-truck me-1"></i>Create Shipment
        </a>
    }

    @* If shipment already exists, show a View Shipment link *@
    @if (Model.Shipment != null)
    {
        <a asp-controller="Shipments" asp-action="Details" asp-route-id="@Model.Shipment.Id"
           class="btn btn-outline-primary">
            <i class="bi bi-truck me-1"></i>Track Shipment @Model.Shipment.TrackingNumber
        </a>
    }

    @* ---- MESSAGE BUTTON ----
       Lets the two parties talk about THIS order. The message gets linked
       to the order (orderId) so it shows an "Order #.." chip in the chat.
       HQ messages the supplier; the supplier messages the branch contact
       (only if that branch actually has a contact user assigned). *@
    @if (isManager)
    {
        <a asp-controller="Messages" asp-action="Compose"
           asp-route-to="@Model.Supplier.UserId" asp-route-orderId="@Model.Id"
           class="btn btn-outline-primary">
            <i class="bi bi-envelope me-1"></i>Message Supplier
        </a>
    }
    else if (isSupplier && !string.IsNullOrEmpty(Model.Store.ManagerUserId))
    {
        <a asp-controller="Messages" asp-action="Compose"
           asp-route-to="@Model.Store.ManagerUserId" asp-route-orderId="@Model.Id"
           class="btn btn-outline-primary">
            <i class="bi bi-envelope me-1"></i>Message Branch
        </a>
    }

    <a asp-action="Index" class="btn btn-outline-secondary ms-auto">
        <i class="bi bi-arrow-left me-1"></i>Back to Orders
    </a>
</div>
