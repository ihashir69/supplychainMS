@* HQ creates a new order — picks which branch and which supplier *@

@model SupplyChainMS.ViewModels.OrderCreateViewModel

@{
    ViewData["Title"] = "New Order";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Orders</a></li>
        <li class="breadcrumb-item active">New Order</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0"><i class="bi bi-plus-circle me-2 text-primary"></i>Create New Order</h4>
            </div>
            <div class="card-body p-4">
                <p class="text-muted mb-4">
                    Select which branch is ordering and which supplier to order from.
                    You'll add products on the next screen.
                </p>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="StoreId" class="form-label fw-semibold"></label>
                        <select asp-for="StoreId" asp-items="ViewBag.StoreList" class="form-select">
                            <option value="">— Select a branch —</option>
                        </select>
                        <span asp-validation-for="StoreId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SupplierId" class="form-label fw-semibold"></label>
                        <select asp-for="SupplierId" asp-items="ViewBag.SupplierList" class="form-select">
                            <option value="">— Select a supplier —</option>
                        </select>
                        <span asp-validation-for="SupplierId" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-semibold"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3"
                                  placeholder="e.g. Urgent delivery needed, deliver before Friday..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-arrow-right me-1"></i>Create &amp; Add Products
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
