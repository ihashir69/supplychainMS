@* Orders list — StoreManager (HQ) sees all orders, Supplier sees only their incoming orders *@

@model List<SupplyChainMS.Models.Order>

@{
    ViewData["Title"] = "Orders";
    bool isSupplier = (ViewBag.Role as string) == "Supplier";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">
            <i class="bi bi-receipt me-2 text-primary"></i>
            @(isSupplier ? "Incoming Orders" : "All Orders")
        </h2>
        <p class="text-muted mb-0">@Model.Count order(s)</p>
    </div>
    @if (!isSupplier)
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>New Order
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-receipt display-1 text-muted"></i>
        <h4 class="mt-3 text-muted">No orders yet</h4>
        @if (!isSupplier)
        {
            <p class="text-muted">Place your first order to a supplier.</p>
            <a asp-action="Create" class="btn btn-primary mt-2">
                <i class="bi bi-plus-lg me-1"></i>Place First Order
            </a>
        }
    </div>
}
else
{
    @* Filter summary chips *@
    var grouped = Model.GroupBy(o => o.Status).OrderBy(g => g.Key).ToList();
    <div class="d-flex gap-2 flex-wrap mb-3">
        @foreach (var g in grouped)
        {
            var badgeClass = g.Key switch
            {
                SupplyChainMS.Models.OrderStatus.Draft     => "bg-secondary",
                SupplyChainMS.Models.OrderStatus.Submitted => "bg-warning text-dark",
                SupplyChainMS.Models.OrderStatus.Confirmed => "bg-primary",
                SupplyChainMS.Models.OrderStatus.Fulfilled => "bg-success",
                SupplyChainMS.Models.OrderStatus.Cancelled => "bg-danger",
                _ => "bg-secondary"
            };
            <span class="badge @badgeClass px-3 py-2">@g.Key: @g.Count()</span>
        }
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Order #</th>
                            @if (isSupplier) { <th>From Branch</th> }
                            else             { <th>Branch</th><th>Supplier</th> }
                            <th>Items</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="fw-semibold">#@order.Id</td>
                                @if (isSupplier)
                                {
                                    <td>@order.Store.Name</td>
                                }
                                else
                                {
                                    <td>@order.Store.Name</td>
                                    <td>@order.Supplier.CompanyName</td>
                                }
                                <td>@order.Items.Count</td>
                                <td>PKR @order.TotalAmount.ToString("N0")</td>
                                <td>
                                    @switch (order.Status)
                                    {
                                        case SupplyChainMS.Models.OrderStatus.Draft:
                                            <span class="badge bg-secondary">Draft</span>
                                            break;
                                        case SupplyChainMS.Models.OrderStatus.Submitted:
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-hourglass-split me-1"></i>Submitted
                                            </span>
                                            break;
                                        case SupplyChainMS.Models.OrderStatus.Confirmed:
                                            <span class="badge bg-primary">
                                                <i class="bi bi-check me-1"></i>Confirmed
                                            </span>
                                            break;
                                        case SupplyChainMS.Models.OrderStatus.Fulfilled:
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle me-1"></i>Fulfilled
                                            </span>
                                            break;
                                        case SupplyChainMS.Models.OrderStatus.Cancelled:
                                            <span class="badge bg-danger">Cancelled</span>
                                            break;
                                    }
                                </td>
                                <td><small class="text-muted">@order.CreatedAt.ToString("dd MMM yyyy")</small></td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@order.Id"
                                       class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-eye me-1"></i>View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
