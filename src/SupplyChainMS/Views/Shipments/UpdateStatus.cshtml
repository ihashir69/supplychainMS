@* Driver or Supplier updates delivery status *@

@model SupplyChainMS.ViewModels.UpdateShipmentStatusViewModel

@{
    ViewData["Title"] = "Update Status";
    ViewData["ActivePage"] = "Shipments";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Shipments</a></li>
        <li class="breadcrumb-item">
            <a asp-action="Details" asp-route-id="@Model.ShipmentId">@Model.TrackingNumber</a>
        </li>
        <li class="breadcrumb-item active">Update Status</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0">
                    <i class="bi bi-arrow-repeat me-2 text-primary"></i>Update Delivery Status
                </h4>
            </div>
            <div class="card-body p-4">
                <div class="bg-light rounded p-3 mb-4">
                    <p class="mb-1 fw-semibold font-monospace">@Model.TrackingNumber</p>
                    <p class="mb-1 small text-muted">Delivering to: @Model.StoreName</p>
                    <p class="mb-0 small">
                        Current status:
                        <span class="badge bg-secondary">@Model.CurrentStatus</span>
                    </p>
                </div>

                <form asp-action="UpdateStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ShipmentId" />
                    <input type="hidden" asp-for="TrackingNumber" />
                    <input type="hidden" asp-for="StoreName" />
                    <input type="hidden" asp-for="CurrentStatus" />

                    <div class="mb-3">
                        <label asp-for="NewStatus" class="form-label fw-semibold"></label>
                        <select asp-for="NewStatus" asp-items="ViewBag.StatusList" class="form-select">
                            <option value="">— Select new status —</option>
                        </select>
                        <span asp-validation-for="NewStatus" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-semibold"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3"
                                  placeholder="e.g. Arrived at warehouse, Delivered to branch manager, Damaged in transit..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Update Status
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.ShipmentId"
                           class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
