@* Shipments list — different content per role *@

@model List<SupplyChainMS.Models.Shipment>

@{
    ViewData["Title"] = "Shipments";
    ViewData["ActivePage"] = "Shipments";
    string role = ViewBag.Role ?? "StoreManager";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">
            <i class="bi bi-truck me-2 text-primary"></i>
            @(role == "Driver" ? "My Deliveries" : role == "Supplier" ? "My Shipments" : "All Deliveries")
        </h2>
        <p class="text-muted mb-0">@Model.Count shipment(s)</p>
    </div>
</div>

@* Status summary chips *@
@if (Model.Any())
{
    var grouped = Model.GroupBy(s => s.Status).OrderBy(g => g.Key);
    <div class="d-flex gap-2 flex-wrap mb-3">
        @foreach (var g in grouped)
        {
            var cls = g.Key switch
            {
                SupplyChainMS.Models.ShipmentStatus.Pending    => "bg-secondary",
                SupplyChainMS.Models.ShipmentStatus.Dispatched => "bg-warning text-dark",
                SupplyChainMS.Models.ShipmentStatus.InTransit  => "bg-primary",
                SupplyChainMS.Models.ShipmentStatus.Delivered  => "bg-success",
                SupplyChainMS.Models.ShipmentStatus.Failed     => "bg-danger",
                _ => "bg-secondary"
            };
            <span class="badge @cls px-3 py-2">@g.Key: @g.Count()</span>
        }
    </div>
}

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-truck display-1 text-muted"></i>
        <h4 class="mt-3 text-muted">No shipments yet</h4>
        @if (role == "Supplier")
        {
            <p class="text-muted">Confirm an order first, then create a shipment from the order details page.</p>
            <a asp-controller="Orders" asp-action="Index" class="btn btn-primary mt-2">
                View Orders
            </a>
        }
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tracking #</th>
                            @if (role != "StoreManager") { <th>Branch</th> }
                            @if (role == "StoreManager") { <th>Branch</th><th>Supplier</th> }
                            @if (role != "Driver") { <th>Driver</th> }
                            <th>Est. Delivery</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td class="fw-semibold font-monospace">@s.TrackingNumber</td>
                                @if (role != "StoreManager")
                                {
                                    <td>@s.Order.Store.Name</td>
                                }
                                @if (role == "StoreManager")
                                {
                                    <td>@s.Order.Store.Name</td>
                                    <td>@s.Order.Supplier.CompanyName</td>
                                }
                                @if (role != "Driver")
                                {
                                    <td>
                                        @if (s.Driver != null)
                                        { <span><i class="bi bi-person me-1"></i>@s.Driver.FullName</span> }
                                        else
                                        { <span class="text-muted">Unassigned</span> }
                                    </td>
                                }
                                <td>
                                    @if (s.EstimatedDeliveryDate.HasValue)
                                    { <small>@s.EstimatedDeliveryDate.Value.ToString("dd MMM yyyy")</small> }
                                    else { <small class="text-muted">—</small> }
                                </td>
                                <td>
                                    @switch (s.Status)
                                    {
                                        case SupplyChainMS.Models.ShipmentStatus.Pending:
                                            <span class="badge bg-secondary">Pending</span>
                                            break;
                                        case SupplyChainMS.Models.ShipmentStatus.Dispatched:
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-arrow-up-right me-1"></i>Dispatched
                                            </span>
                                            break;
                                        case SupplyChainMS.Models.ShipmentStatus.InTransit:
                                            <span class="badge bg-primary">
                                                <i class="bi bi-truck me-1"></i>In Transit
                                            </span>
                                            break;
                                        case SupplyChainMS.Models.ShipmentStatus.Delivered:
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle me-1"></i>Delivered
                                            </span>
                                            break;
                                        case SupplyChainMS.Models.ShipmentStatus.Failed:
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle me-1"></i>Failed
                                            </span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@s.Id"
                                       class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-eye me-1"></i>View
                                    </a>
                                    @if ((role == "Driver" || role == "Supplier") &&
                                         s.Status != SupplyChainMS.Models.ShipmentStatus.Delivered &&
                                         s.Status != SupplyChainMS.Models.ShipmentStatus.Failed)
                                    {
                                        <a asp-action="UpdateStatus" asp-route-id="@s.Id"
                                           class="btn btn-outline-warning btn-sm ms-1">
                                            <i class="bi bi-arrow-repeat me-1"></i>Update
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
