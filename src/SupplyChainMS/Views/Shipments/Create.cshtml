@* Supplier creates a shipment for a Confirmed order *@

@model SupplyChainMS.ViewModels.ShipmentCreateViewModel

@{
    ViewData["Title"] = "Create Shipment";
    ViewData["ActivePage"] = "Shipments";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-controller="Orders" asp-action="Index">Orders</a></li>
        <li class="breadcrumb-item">
            <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId">Order #@Model.OrderId</a>
        </li>
        <li class="breadcrumb-item active">Create Shipment</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0">
                    <i class="bi bi-truck me-2 text-primary"></i>Create Shipment
                </h4>
                <small class="text-muted">
                    Order #@Model.OrderId — @Model.StoreName from @Model.SupplierName
                </small>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    A tracking number will be generated automatically.
                    The initial status will be <strong>Pending</strong>.
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="OrderId" />
                    <input type="hidden" asp-for="StoreName" />
                    <input type="hidden" asp-for="SupplierName" />

                    <div class="mb-3">
                        <label asp-for="DriverId" class="form-label fw-semibold"></label>
                        <select asp-for="DriverId" asp-items="ViewBag.DriverList" class="form-select">
                            <option value="">— Assign later (optional) —</option>
                        </select>
                        <small class="text-muted">You can assign a driver now or after creating the shipment.</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EstimatedDeliveryDate" class="form-label fw-semibold"></label>
                        <input asp-for="EstimatedDeliveryDate" class="form-control" type="date"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="EstimatedDeliveryDate" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="DeliveryNotes" class="form-label fw-semibold"></label>
                        <textarea asp-for="DeliveryNotes" class="form-control" rows="3"
                                  placeholder="e.g. Call branch manager before arrival. Use rear loading dock."></textarea>
                        <span asp-validation-for="DeliveryNotes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-truck me-1"></i>Create Shipment
                        </button>
                        <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId"
                           class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
