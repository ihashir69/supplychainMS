@* Dashboard — shows different content based on the logged-in user's role *@

@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";
    var userName = ViewBag.UserName as string ?? "User";
    var userRole = ViewBag.UserRole as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">
            @if (userRole == "Supplier")
            { <i class="bi bi-building text-warning me-2"></i> }
            else if (userRole == "StoreManager")
            { <i class="bi bi-shop text-success me-2"></i> }
            else if (userRole == "Driver")
            { <i class="bi bi-truck text-info me-2"></i> }
            Welcome, @userName!
        </h2>
        <p class="text-muted mb-0">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
    </div>
    <span class="badge fs-6 @(userRole == "Supplier" ? "bg-warning text-dark" : userRole == "StoreManager" ? "bg-success" : "bg-info text-dark")">
        @userRole
    </span>
</div>

@* ---- SUPPLIER DASHBOARD ---- *@
@if (User.IsInRole("Supplier"))
{
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="bg-warning bg-opacity-10 rounded-3 p-3">
                        <i class="bi bi-receipt text-warning fs-2"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-0 small">Pending Orders</p>
                        <h3 class="fw-bold mb-0">--</h3>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 pt-0">
                    <a asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-outline-warning w-100">View Orders</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                        <i class="bi bi-box-seam text-primary fs-2"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-0 small">My Products</p>
                        <h3 class="fw-bold mb-0">--</h3>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 pt-0">
                    <a asp-controller="Products" asp-action="Index" class="btn btn-sm btn-outline-primary w-100">Manage Products</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="bg-success bg-opacity-10 rounded-3 p-3">
                        <i class="bi bi-truck text-success fs-2"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-0 small">Active Shipments</p>
                        <h3 class="fw-bold mb-0">--</h3>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 pt-0">
                    <a asp-controller="Shipments" asp-action="Index" class="btn btn-sm btn-outline-success w-100">Track Shipments</a>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent border-0 pt-3 pb-0">
            <h5 class="fw-semibold">Quick Actions</h5>
        </div>
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Products" asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>Add Product
                </a>
                <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-receipt me-2"></i>View Incoming Orders
                </a>
                <a asp-controller="Messages" asp-action="Inbox" class="btn btn-outline-secondary">
                    <i class="bi bi-envelope me-2"></i>Inbox
                </a>
            </div>
        </div>
    </div>
}

