        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                        <i class="bi bi-cart text-primary fs-2"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-0 small">Active Orders</p>
                        <h3 class="fw-bold mb-0">--</h3>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 pt-0">
                    <a asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-outline-primary w-100">View Orders</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="bg-success bg-opacity-10 rounded-3 p-3">
                        <i class="bi bi-geo-alt text-success fs-2"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-0 small">Pending Deliveries</p>
                        <h3 class="fw-bold mb-0">--</h3>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 pt-0">
                    <a asp-controller="Shipments" asp-action="Index" class="btn btn-sm btn-outline-success w-100">Track Deliveries</a>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent border-0 pt-3 pb-0">
            <h5 class="fw-semibold">Quick Actions</h5>
        </div>
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Orders" asp-action="Create" class="btn btn-success">
                    <i class="bi bi-plus-circle me-2"></i>Place New Order
                </a>
                <a asp-controller="Suppliers" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-building me-2"></i>Browse Suppliers
                </a>
                <a asp-controller="Stores" asp-action="Inventory" class="btn btn-outline-secondary">
                    <i class="bi bi-clipboard-data me-2"></i>Check Inventory
                </a>
            </div>
        </div>
    </div>
}

