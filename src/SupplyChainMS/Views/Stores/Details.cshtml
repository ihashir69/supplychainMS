@* Store profile view — accessible to both StoreManager and Supplier *@

@model SupplyChainMS.Models.Store

@{
    ViewData["Title"] = Model.Name;
    var isManager = User.IsInRole("StoreManager");
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
        @if (!isManager)
        {
            <li class="breadcrumb-item"><a asp-action="Index">Stores</a></li>
        }
        <li class="breadcrumb-item active">@Model.Name</li>
    </ol>
</nav>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                            <i class="bi bi-shop text-success fs-3"></i>
                        </div>
                        <div>
                            <h3 class="mb-0">@Model.Name</h3>
                            <span class="badge bg-success">Active Store</span>
                        </div>
                    </div>
                    @if (isManager)
                    {
                        <div class="d-flex gap-2">
                            <a asp-action="EditProfile" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                                <i class="bi bi-pencil me-1"></i>Edit
                            </a>
                            <a asp-action="Inventory" asp-route-id="@Model.Id" class="btn btn-primary">
                                <i class="bi bi-clipboard-data me-1"></i>View Inventory
                            </a>
                        </div>
                    }
                </div>

                <hr class="my-3" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <p class="mb-1 text-muted small fw-bold">MANAGER</p>
                        <p class="mb-0"><i class="bi bi-person me-1"></i>@Model.Manager?.FullName</p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-1 text-muted small fw-bold">CONTACT EMAIL</p>
                        <p class="mb-0"><i class="bi bi-envelope me-1"></i>@Model.ContactEmail</p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-1 text-muted small fw-bold">PHONE</p>
                        <p class="mb-0"><i class="bi bi-telephone me-1"></i>@Model.ContactPhone</p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-1 text-muted small fw-bold">ESTABLISHED</p>
                        <p class="mb-0"><i class="bi bi-calendar3 me-1"></i>@Model.CreatedAt.ToString("dd MMM yyyy")</p>
                    </div>
                    <div class="col-12">
                        <p class="mb-1 text-muted small fw-bold">ADDRESS</p>
                        <p class="mb-0"><i class="bi bi-geo-alt me-1"></i>@Model.Address</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
