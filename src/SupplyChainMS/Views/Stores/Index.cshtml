@* Shown to Suppliers — a directory of all active stores (their customers) *@

@model List<SupplyChainMS.Models.Store>

@{
    ViewData["Title"] = "Store Directory";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0"><i class="bi bi-shop me-2 text-primary"></i>Store Directory</h2>
        <p class="text-muted mb-0">All active stores that can place orders</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-shop display-1 text-muted"></i>
        <h4 class="mt-3 text-muted">No stores available yet</h4>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var store in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                                <i class="bi bi-shop text-success fs-4"></i>
                            </div>
                            <div>
                                <h5 class="card-title mb-0">@store.Name</h5>
                                <small class="text-muted">
                                    <i class="bi bi-person me-1"></i>@store.Manager?.FullName
                                </small>
                            </div>
                        </div>
                        <p class="mb-1 small">
                            <i class="bi bi-envelope me-1 text-muted"></i>@store.ContactEmail
                        </p>
                        <p class="mb-1 small">
                            <i class="bi bi-telephone me-1 text-muted"></i>@store.ContactPhone
                        </p>
                        <p class="mb-0 small text-muted">
                            <i class="bi bi-geo-alt me-1"></i>@store.Address
                        </p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3">
                        <a asp-action="Details" asp-route-id="@store.Id"
                           class="btn btn-outline-success btn-sm w-100">
                            <i class="bi bi-eye me-1"></i>View Store
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
