@* Branch directory — HQ sees all branches with Inventory + Edit buttons per card *@

@model List<SupplyChainMS.Models.Store>

@{
    ViewData["Title"] = "Store Branches";
    ViewData["ActivePage"] = "Stores";
    bool isManager = User.IsInRole("StoreManager");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0"><i class="bi bi-shop me-2 text-primary"></i>Store Branches</h2>
        <p class="text-muted mb-0">@Model.Count active branch(es)</p>
    </div>
    @if (isManager)
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add Branch
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-shop display-1 text-muted"></i>
        <h4 class="mt-3 text-muted">No branches yet</h4>
        @if (isManager)
        {
            <a asp-action="Create" class="btn btn-primary mt-2">
                <i class="bi bi-plus-lg me-1"></i>Add First Branch
            </a>
        }
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var store in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                                <i class="bi bi-shop text-success fs-4"></i>
                            </div>
                            <div>
                                <h5 class="card-title mb-0">@store.Name</h5>
                                <small class="text-muted">
                                    <i class="bi bi-geo-alt me-1"></i>@store.Address
                                </small>
                            </div>
                        </div>
                        <p class="mb-1 small">
                            <i class="bi bi-telephone me-1 text-muted"></i>@store.ContactPhone
                        </p>
                        <p class="mb-0 small">
                            <i class="bi bi-envelope me-1 text-muted"></i>@store.ContactEmail
                        </p>
                    </div>

                    <div class="card-footer bg-transparent border-0 pb-3">
                        @if (isManager)
                        {
                            <div class="d-flex gap-2">
                                @* Inventory button — passes the store's id so controller knows which branch *@
                                <a asp-action="Inventory" asp-route-id="@store.Id"
                                   class="btn btn-primary btn-sm flex-fill">
                                    <i class="bi bi-clipboard-data me-1"></i>Inventory
                                </a>
                                <a asp-action="EditProfile" asp-route-id="@store.Id"
                                   class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </div>
                        }
                        else
                        {
                            <a asp-action="Details" asp-route-id="@store.Id"
                               class="btn btn-outline-success btn-sm w-100">
                                <i class="bi bi-eye me-1"></i>View Branch
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
