@*
   Views/Suppliers/EditProfile.cshtml
   Form for a supplier to edit their own business profile.

   @model = SupplierProfileEditViewModel — only the fields the form controls.
   Tag Helpers used:
     asp-for="CompanyName"    → generates <input name="CompanyName" id="CompanyName">
                                 and also wires up validation
     asp-validation-for="..." → shows the validation error message for that field
*@

@model SupplyChainMS.ViewModels.SupplierProfileEditViewModel

@{
    ViewData["Title"] = "Edit Profile";
}

@* ---- BREADCRUMB ---- *@
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">My Profile</a></li>
        <li class="breadcrumb-item active">Edit Profile</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit Business Profile</h4>
            </div>
            <div class="card-body p-4">

                @*
                   asp-action="EditProfile"  → form submits to POST /Suppliers/EditProfile
                   method="post"             → HTTP POST (required for form submissions that change data)
                *@
                <form asp-action="EditProfile" method="post">
                    @*
                       Anti-forgery token — a hidden security field.
                       ASP.NET generates a unique token and checks it on POST.
                       This prevents CSRF attacks (where another site tricks the browser
                       into submitting this form without the user knowing).
                    *@
                    @Html.AntiForgeryToken()

                    @* Pass the supplier Id so the controller knows which record to update *@
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="CompanyName" class="form-label fw-semibold"></label>
                        <input asp-for="CompanyName" class="form-control" placeholder="e.g. Khan Electronics" />
                        @* This shows the validation error if CompanyName is empty *@
                        <span asp-validation-for="CompanyName" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="ContactEmail" class="form-label fw-semibold"></label>
                            <input asp-for="ContactEmail" class="form-control" type="email" />
                            <span asp-validation-for="ContactEmail" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ContactPhone" class="form-label fw-semibold"></label>
                            <input asp-for="ContactPhone" class="form-control" placeholder="e.g. 0300-1234567" />
                            <span asp-validation-for="ContactPhone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label fw-semibold"></label>
                        <input asp-for="Address" class="form-control" placeholder="e.g. Plot 45, SITE Industrial Area, Karachi" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        @* textarea for multi-line text — rows="4" makes it taller *@
                        <textarea asp-for="Description" class="form-control" rows="4"
                                  placeholder="Tell store managers what you supply, your strengths, experience, etc."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-floppy me-1"></i>Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@* ---- Client-side validation scripts ---- *@
@* These make validation errors appear instantly without a page reload *@
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
