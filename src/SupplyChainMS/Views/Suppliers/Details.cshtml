@*
   Views/Suppliers/Details.cshtml
   Shows a supplier's full profile + their product catalog.
   Used by both:
     - Suppliers (viewing their own profile)
     - StoreManagers (browsing a supplier before placing an order)
*@

@model SupplyChainMS.Models.Supplier

@{
    ViewData["Title"] = Model.CompanyName;
    // Check if the logged-in user is the owner of this profile
    var isOwner = User.IsInRole("Supplier");
}

@* ---- BREADCRUMB navigation ---- *@
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-controller="Home" asp-action="Index">Dashboard</a>
        </li>
        @if (!isOwner)
        {
            <li class="breadcrumb-item">
                <a asp-controller="Suppliers" asp-action="Index">Suppliers</a>
            </li>
        }
        <li class="breadcrumb-item active">@Model.CompanyName</li>
    </ol>
</nav>

@* ---- SUPPLIER PROFILE CARD ---- *@
<div class="row mb-4">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                            <i class="bi bi-building text-primary fs-3"></i>
                        </div>
                        <div>
                            <h3 class="mb-0">@Model.CompanyName</h3>
                            <span class="badge bg-success">Active Supplier</span>
                        </div>
                    </div>

                    @* Only the supplier (owner) sees the Edit button *@
                    @if (isOwner)
                    {
                        <a asp-action="EditProfile" class="btn btn-outline-primary">
                            <i class="bi bi-pencil me-1"></i>Edit Profile
                        </a>
                    }
                </div>

                <hr class="my-3" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <p class="mb-1 text-muted small fw-bold">CONTACT EMAIL</p>
                        <p class="mb-0"><i class="bi bi-envelope me-1"></i>@Model.ContactEmail</p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-1 text-muted small fw-bold">PHONE</p>
                        <p class="mb-0"><i class="bi bi-telephone me-1"></i>@Model.ContactPhone</p>
                    </div>
                    <div class="col-12">
                        <p class="mb-1 text-muted small fw-bold">ADDRESS</p>
                        <p class="mb-0"><i class="bi bi-geo-alt me-1"></i>@Model.Address</p>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="col-12">
                            <p class="mb-1 text-muted small fw-bold">ABOUT</p>
                            <p class="mb-0">@Model.Description</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ---- STATS SIDEBAR ---- *@
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body text-center d-flex flex-column justify-content-center">
                <div class="display-4 fw-bold text-primary">
                    @Model.Products.Count(p => p.IsActive)
                </div>
                <p class="text-muted mb-0">Active Products</p>
                <hr />
                <small class="text-muted">
                    <i class="bi bi-calendar3 me-1"></i>
                    Supplier since @Model.CreatedAt.ToString("MMM yyyy")
                </small>
            </div>
        </div>
    </div>
</div>

@* ---- PRODUCT CATALOG ---- *@
<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0"><i class="bi bi-box-seam me-2"></i>Product Catalog</h5>

        @* Only the supplier can add new products *@
        @if (isOwner)
        {
            <a asp-controller="Products" asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>Add Product
            </a>
        }
        else
        {
            @* StoreManager sees a link to the Products index for this supplier *@
            <a asp-controller="Products" asp-action="Index"
               asp-route-supplierId="@Model.Id"
               class="btn btn-outline-primary btn-sm">
                <i class="bi bi-grid me-1"></i>Browse All
            </a>
        }
    </div>

    <div class="card-body p-0">
        @if (!Model.Products.Any(p => p.IsActive))
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-box display-4"></i>
                <p class="mt-2 mb-0">No products listed yet.</p>
                @if (isOwner)
                {
                    <a asp-controller="Products" asp-action="Create" class="btn btn-primary mt-2">
                        <i class="bi bi-plus-lg me-1"></i>Add Your First Product
                    </a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Product Name</th>
                            <th>Category</th>
                            <th>Unit Price</th>
                            <th>Unit</th>
                            <th>In Stock</th>
                            @if (isOwner)
                            {
                                <th>Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.Products.Where(p => p.IsActive))
                        {
                            <tr>
                                <td>
                                    <strong>@product.Name</strong>
                                    @if (!string.IsNullOrEmpty(product.Description))
                                    {
                                        <br />
                                        <small class="text-muted">@product.Description</small>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(product.Category))
                                    {
                                        <span class="badge bg-secondary">@product.Category</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="fw-bold">PKR @product.UnitPrice.ToString("N0")</td>
                                <td>@product.Unit</td>
                                <td>
                                    @* Color-code stock levels *@
                                    @if (product.StockQuantity == 0)
                                    {
                                        <span class="badge bg-danger">Out of Stock</span>
                                    }
                                    else if (product.StockQuantity < 20)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            @product.StockQuantity (Low)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@product.StockQuantity</span>
                                    }
                                </td>
                                @if (isOwner)
                                {
                                    <td>
                                        <a asp-controller="Products" asp-action="Edit"
                                           asp-route-id="@product.Id"
                                           class="btn btn-outline-secondary btn-sm me-1">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-controller="Products" asp-action="Delete"
                                           asp-route-id="@product.Id"
                                           class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
