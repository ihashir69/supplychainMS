@*
   _Layout.cshtml — Master Template
   Every page inherits this. RenderBody() is where each page's content is inserted.
   Razor syntax: use @ to write C# inside HTML. This comment uses at-star syntax.
*@

@using Microsoft.AspNetCore.Identity
@using SupplyChainMS.Models
@using SupplyChainMS.Services.Interfaces
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@* Injecting the message service here lets EVERY page show the unread
   count in the sidebar (like the little number on an email icon). *@
@inject IMessageService MessageService

@{
    // Work out the current user's unread message count ONCE, so we can
    // show a red badge next to the "Inbox" link. Only bother if logged in.
    var unreadMessages = 0;
    if (SignInManager.IsSignedIn(User))
    {
        var uid = UserManager.GetUserId(User);
        if (uid != null) { unreadMessages = await MessageService.GetUnreadCountAsync(uid); }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SupplyChain MS</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons CDN — gives us icons like bi-truck, bi-boxes etc. -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Our custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">

@* ---- TOP NAVBAR ---- *@
<nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm fixed-top">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
            <i class="bi bi-boxes me-2"></i>SupplyChain MS
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarTop">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarTop">
            <ul class="navbar-nav ms-auto align-items-center">

                @if (SignInManager.IsSignedIn(User))
                {
                    var currentUser = await UserManager.GetUserAsync(User);
                    <li class="nav-item me-3">
                        @if (User.IsInRole("Supplier"))
                        {
                            <span class="badge bg-warning text-dark"><i class="bi bi-building me-1"></i>Supplier</span>
                        }
                        else if (User.IsInRole("StoreManager"))
                        {
                            <span class="badge bg-success"><i class="bi bi-shop me-1"></i>Store Manager</span>
                        }
                        else if (User.IsInRole("Driver"))
                        {
                            <span class="badge bg-info text-dark"><i class="bi bi-truck me-1"></i>Driver</span>
                        }
                    </li>
                    <li class="nav-item me-3">
                        <span class="text-white-50 small">@currentUser?.FullName</span>
                    </li>
                    <li class="nav-item">
                        @* POST logout — security: logout must be POST, not GET *@
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-light btn-sm">
                                <i class="bi bi-box-arrow-right me-1"></i>Logout
                            </button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Login
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

@* ---- MAIN LAYOUT: sidebar + content ---- *@
<div class="container-fluid" style="padding-top: 70px;">
    <div class="row">

        @if (SignInManager.IsSignedIn(User))
        {
            @* ---- LEFT SIDEBAR ---- *@
            <nav class="col-md-2 d-none d-md-block bg-white shadow-sm py-3" style="min-height: calc(100vh - 70px); position: sticky; top: 70px; overflow-y: auto;">
                <ul class="nav flex-column">

                    @* Dashboard — visible to all roles *@
                    <li class="nav-item">
                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "active fw-bold" : "text-secondary")"
                           asp-controller="Home" asp-action="Index">
                            <i class="bi bi-speedometer2 me-2"></i>Dashboard
                        </a>
                    </li>

                    @* ---- SUPPLIER navigation ---- *@
                    @if (User.IsInRole("Supplier"))
                    {
                        <li class="nav-item mt-3">
                            <span class="px-3 text-muted small text-uppercase fw-bold">My Business</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Products" ? "active fw-bold" : "text-secondary")"
                               asp-controller="Products" asp-action="Index">
                                <i class="bi bi-box-seam me-2"></i>My Products
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Orders" ? "active fw-bold" : "text-secondary")"
                               asp-controller="Orders" asp-action="Index">
                                <i class="bi bi-receipt me-2"></i>Incoming Orders
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Shipments" ? "active fw-bold" : "text-secondary")"
                               asp-controller="Shipments" asp-action="Index">
                                <i class="bi bi-truck me-2"></i>Shipments
                            </a>
                        </li>
                    }

                    @* ---- STORE MANAGER (HQ) navigation ---- *@
                    @if (User.IsInRole("StoreManager"))
                    {
                        <li class="nav-item mt-3">
                            <span class="px-3 text-muted small text-uppercase fw-bold">Branches</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Stores" ? "active fw-bold" : "text-secondary")"
                               asp-controller="Stores" asp-action="Index">
                                <i class="bi bi-shop me-2"></i>All Branches
                            </a>
                        </li>
                        <li class="nav-item">
                            @* Inventory requires picking a branch — goes to branch list first *@
                            <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Inventory" ? "active fw-bold" : "text-secondary")"
                               asp-controller="Stores" asp-action="Index">
                                <i class="bi bi-clipboard-data me-2"></i>Inventory
                            </a>
                        </li>
                        <li class="nav-item mt-3">
                            <span class="px-3 text-muted small text-uppercase fw-bold">Procurement</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Suppliers" ? "active fw-bold" : "text-secondary")"
                               asp-controller="Suppliers" asp-action="Index">
                                <i class="bi bi-building me-2"></i>Suppliers
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Orders" ? "active fw-bold" : "text-secondary")"
                               asp-controller="Orders" asp-action="Index">
                                <i class="bi bi-cart me-2"></i>Orders
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Shipments" ? "active fw-bold" : "text-secondary")"
                               asp-controller="Shipments" asp-action="Index">
                                <i class="bi bi-geo-alt me-2"></i>Deliveries
                            </a>
                        </li>
                    }

                    @* ---- DRIVER navigation ---- *@
                    @if (User.IsInRole("Driver"))
                    {
                        <li class="nav-item mt-3">
                            <span class="px-3 text-muted small text-uppercase fw-bold">My Deliveries</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Shipments" ? "active fw-bold" : "text-secondary")"
                               asp-controller="Shipments" asp-action="Index">
                                <i class="bi bi-truck me-2"></i>Assigned Deliveries
                            </a>
                        </li>
                    }

                    @* ---- MESSAGES — all roles ---- *@
                    <li class="nav-item mt-3">
                        <span class="px-3 text-muted small text-uppercase fw-bold">Communication</span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center @(ViewData["ActivePage"]?.ToString() == "Messages" ? "active fw-bold" : "text-secondary")"
                           asp-controller="Messages" asp-action="Inbox">
                            <i class="bi bi-envelope me-2"></i>Inbox
                            @* Red unread badge — only shown when there's something new *@
                            @if (unreadMessages > 0)
                            {
                                <span class="badge bg-danger rounded-pill ms-auto">@unreadMessages</span>
                            }
                        </a>
                    </li>

                </ul>
            </nav>

            @* ---- MAIN CONTENT AREA ---- *@
            <main class="col-md-10 ms-sm-auto px-4 py-4">

                @* Flash messages are now shown as "toasts" (little pop-up
                   notifications in the corner). See the toast container near
                   the bottom of this file. TempData survives ONE redirect,
                   which is exactly how long a flash message needs to live. *@

                @RenderBody()
            </main>
        }
        else
        {
            @* Not logged in: full-width layout (for Login/Register pages) *@
            <main class="col-12">
                @RenderBody()
            </main>
        }

    </div>
</div>

@* ---- TOAST NOTIFICATIONS ----
   A "toast" is a small message that slides in, shows for a few seconds,
   then fades away — like a phone notification. We put success/error
   flash messages here. They live in a fixed container in the top-right
   corner so they float above the page content. *@
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1200; margin-top: 70px;">
    @if (TempData["Success"] != null)
    {
        <div class="toast align-items-center text-white bg-success border-0 app-toast" role="alert" data-bs-delay="4000">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast align-items-center text-white bg-danger border-0 app-toast" role="alert" data-bs-delay="6000">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    }
</div>

<!-- jQuery -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<!-- Bootstrap 5 JS bundle -->
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<!-- Our custom JS -->
<script src="~/js/site.js" asp-append-version="true"></script>

@* Individual pages can add their own scripts in a "Scripts" section *@
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
